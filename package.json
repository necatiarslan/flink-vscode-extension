{
  "name": "apache-flink-manager",
  "displayName": "Apache Flink Manager",
  "description": "Manage Apache Flink clusters from VS Code",
  "version": "1.0.2",
  "publisher": "NecatiARSLAN",
  "repository": {
    "type": "git",
    "url": "https://github.com/necatiarslan/flink-vscode-extension"
  },
  "icon": "media/flink-vscode-extension-logo.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Apache Flink",
    "Data Stream Processing"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ApacheFlink.AddCluster",
        "title": "Apache Flink: Add Cluster",
        "icon": "$(add)"
      },
      {
        "command": "ApacheFlink.EditCluster",
        "title": "Apache Flink: Edit Cluster",
        "icon": "$(pencil)"
      },
      {
        "command": "ApacheFlink.RemoveCluster",
        "title": "Apache Flink: Remove Cluster",
        "icon": "$(trash)"
      },
      {
        "command": "ApacheFlink.TestConnection",
        "title": "Apache Flink: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "ApacheFlink.Refresh",
        "title": "Apache Flink: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "_ApacheFlink.UploadJar#sideBar",
        "title": "Upload JAR",
        "icon": "$(add)"
      },
      {
        "command": "_ApacheFlink.CancelJob#sideBar",
        "title": "Cancel Job",
        "icon": "$(debug-stop)"
      },
      {
        "command": "flink.runSql",
        "title": "Flink: Run SQL",
        "icon": "$(play)"
      },
      {
        "command": "flink.newJob",
        "title": "Flink: New Job",
        "icon": "$(add)"
      },
      {
        "command": "flink.openJobSpec",
        "title": "Flink: Open Job Spec",
        "icon": "$(edit)"
      }
    ],
    "configuration": {
      "title": "Apache Flink",
      "properties": {
        "flink.sql.maxRows": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Maximum number of SQL result rows to display before cancelling the operation."
        },
        "flink.sql.statementTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "description": "Statement execution timeout in seconds for Flink SQL Gateway."
        },
        "flink.preview.maxRows": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "description": "Maximum number of rows returned by a Job Designer preview."
        },
        "flink.preview.timeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "description": "Maximum duration of a Job Designer preview before the Gateway operation is cancelled."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "flink.runSql",
          "when": "resourceLangId == sql",
          "group": "navigation"
        },
        {
          "command": "flink.openJobSpec",
          "when": "resourceFilename =~ /\\.flinkjob\\.json$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "flink.runSql",
          "when": "resourceLangId == sql",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "ApacheFlink.AddCluster",
          "when": "view == ApacheFlinkView",
          "group": "navigation"
        },
        {
          "command": "ApacheFlink.Refresh",
          "when": "view == ApacheFlinkView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flink.newJob",
          "when": "view == ApacheFlinkView && viewItem == flinkClusterWithSqlGateway",
          "group": "inline@2"
        },
        {
          "command": "flink.newJob",
          "when": "view == ApacheFlinkView && viewItem == flinkJobsWithSqlGateway",
          "group": "inline@2"
        },
        {
          "command": "_ApacheFlink.UploadJar#sideBar",
          "when": "view == ApacheFlinkView && viewItem == flinkJarsWritable",
          "group": "inline@1"
        },
        {
          "command": "_ApacheFlink.CancelJob#sideBar",
          "when": "view == ApacheFlinkView && viewItem == flinkJobRunningWritable",
          "group": "inline@1"
        },
        {
          "command": "ApacheFlink.EditCluster",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        },
        {
          "command": "ApacheFlink.RemoveCluster",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        },
        {
          "command": "ApacheFlink.TestConnection",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ApacheFlink",
          "title": "Apache Flink",
          "icon": "media/flink-vscode-extension-activitybar.png"
        }
      ]
    },
    "views": {
      "ApacheFlink": [
        { 
          "id": "ApacheFlinkView",
          "name": "Clusters",
          "icon": "media/flink-vscode-extension-activitybar.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ApacheFlinkView",
        "contents": "No Flink clusters configured. [Add a cluster](command:ApacheFlink.AddCluster)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run compile && node --test out/flink/*.test.js out/jobdesigner/*.test.js",
    "test:integration": "npm run compile && node --test out/jobdesigner/*.integration.test.js",
    "producer:files": "tsc -p tsconfig.tools.json && node out-tools/fileProducer.js",
    "produce:events": "tsc -p tsconfig.tools.json && node out-tools/eventProducer.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3"
  }
}
