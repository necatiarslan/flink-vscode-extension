{
  "name": "flink-vscode-extension",
  "displayName": "Flink VS Code Extension",
  "description": "Manage Apache Flink clusters from VS Code",
  "version": "1.0.0",
  "publisher": "NecatiARSLAN",
  "repository": {
    "type": "git",
    "url": "https://github.com/necatiarslan/flink-vscode-extension"
  },
  "icon": "media/flink-vscode-extension-logo.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Apache Flink",
    "Data Stream Processing"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ApacheFlink.AddCluster",
        "title": "Apache Flink: Add Cluster",
        "icon": "$(add)"
      },
      {
        "command": "ApacheFlink.EditCluster",
        "title": "Apache Flink: Edit Cluster",
        "icon": "$(pencil)"
      },
      {
        "command": "ApacheFlink.RemoveCluster",
        "title": "Apache Flink: Remove Cluster",
        "icon": "$(trash)"
      },
      {
        "command": "ApacheFlink.TestConnection",
        "title": "Apache Flink: Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "ApacheFlink.Refresh",
        "title": "Apache Flink: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ApacheFlink.AddCluster",
          "when": "view == ApacheFlinkView",
          "group": "navigation"
        },
        {
          "command": "ApacheFlink.Refresh",
          "when": "view == ApacheFlinkView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ApacheFlink.EditCluster",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        },
        {
          "command": "ApacheFlink.RemoveCluster",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        },
        {
          "command": "ApacheFlink.TestConnection",
          "when": "view == ApacheFlinkView && viewItem == flinkCluster",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ApacheFlink",
          "title": "Apache Flink",
          "icon": "media/flink-vscode-extension-logo.png"
        }
      ]
    },
    "views": {
      "ApacheFlink": [
        {
          "id": "ApacheFlinkView",
          "name": "Clusters",
          "icon": "media/flink-vscode-extension-logo.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ApacheFlinkView",
        "contents": "No Flink clusters configured. [Add a cluster](command:ApacheFlink.AddCluster)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run compile && npm run lint"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3"
  }
}
